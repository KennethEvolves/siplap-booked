generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activities {
  activity_id           String                  @id(map: "activities_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String?                 @db.VarChar(255)
  description           String?
  type                  activity_type?
  start_date            DateTime?               @db.Date
  end_date              DateTime?               @db.Date
  general_observation   String?
  requires_certified    Boolean?
  requires_authority    Boolean?
  planning_approved     activity_status         @default(pending)
  academic_approved     activity_status         @default(pending)
  admin_approved        activity_status         @default(pending)
  overall_status        activity_status         @default(pending)
  objective_id          String?                 @db.Uuid
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  creator_id            String                  @db.Uuid
  users                 users                   @relation(fields: [creator_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "activities_creator_id_fk")
  objectives            objectives?             @relation(fields: [objective_id], references: [objective_id], onDelete: NoAction, onUpdate: NoAction, map: "activities_objective_id_fk")
  activity_personnel    activity_personnel[]
  activity_reports      activity_reports?
  activity_requirements activity_requirements[]
  notifications         notifications[]
  reservations          reservations[]
}

model activity_personnel {
  activity_id String     @db.Uuid
  user_id     String     @db.Uuid
  activities  activities @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade, onUpdate: NoAction, map: "activity_personnel_activity_fkey")
  users       users      @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "activity_personnel_user_fkey")

  @@id([activity_id, user_id])
}

model activity_report_evidences {
  evidence_id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id        String           @db.Uuid
  image_url        String
  caption          String?          @db.VarChar(255)
  uploaded_at      DateTime?        @default(now()) @db.Timestamptz(6)
  activity_reports activity_reports @relation(fields: [report_id], references: [report_id], onDelete: Cascade, onUpdate: NoAction, map: "report_evidences_report_fk")
}

model activity_reports {
  report_id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id               String                      @unique @db.Uuid
  folio                     String                      @db.VarChar(50)
  report_date               DateTime                    @default(dbgenerated("CURRENT_DATE")) @db.Date
  results_summary           String
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  activity_report_evidences activity_report_evidences[]
  activities                activities                  @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade, onUpdate: NoAction, map: "activity_reports_activity_fk")
}

model activity_requirements {
  requirement_id    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id       String              @db.Uuid
  category_type     String              @db.VarChar(50)
  total_amount      Decimal             @default(0) @db.Decimal(12, 2)
  observations      String?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  activities        activities          @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade, onUpdate: NoAction)
  requirement_items requirement_items[]
}

model axis {
  axis_id     String       @id(map: "axis_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?      @db.VarChar(255)
  description String?
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @default(now()) @db.Timestamptz(6)
  objectives  objectives[]
}

model departments {
  department_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String      @db.VarChar(150)
  description   String?
  packages      packages[]
  resources     resources[]
  users         users[]
}

model flight_requirements_meta {
  flight_meta_id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id           String            @db.Uuid
  flight_type       String            @db.VarChar(20)
  passenger_name    String?           @db.VarChar(200)
  origin            String            @db.VarChar(100)
  destination       String            @db.VarChar(255)
  departure_date    DateTime          @db.Date
  departure_time    DateTime?         @db.Time(6)
  return_date       DateTime?         @db.Date
  return_time       DateTime?         @db.Time(6)
  commission_motive String
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  requirement_items requirement_items @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
}

model item_catalogs {
  catalog_id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(150)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  requirement_items requirement_items[]
}

model lodging_requirements_meta {
  lodging_meta_id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id              String            @db.Uuid
  hotel_name_suggested String?           @db.VarChar(255)
  check_in_date        DateTime          @db.Date
  check_out_date       DateTime          @db.Date
  nights_count         Int
  city_destination     String            @db.VarChar(150)
  justification        String
  created_at           DateTime?         @default(now()) @db.Timestamptz(6)
  requirement_items    requirement_items @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  notification_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String        @db.Uuid
  activity_id     String?       @db.Uuid
  reservation_id  String?       @db.Uuid
  title           String        @db.VarChar(200)
  message         String
  type            String?       @db.VarChar(50)
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  activities      activities?   @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade, onUpdate: NoAction)
  reservations    reservations? @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model objectives {
  objective_id String       @id(map: "objectives_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?      @db.VarChar(255)
  description  String?
  axis_id      String?      @db.Uuid
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @default(now()) @db.Timestamptz(6)
  activities   activities[]
  axis         axis?        @relation(fields: [axis_id], references: [axis_id], onDelete: NoAction, onUpdate: NoAction, map: "objective_axis_id_fk")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model package_items {
  package_id  String    @db.Uuid
  resource_id String    @db.Uuid
  quantity    Int
  packages    packages  @relation(fields: [package_id], references: [package_id], onDelete: Cascade, onUpdate: NoAction)
  resources   resources @relation(fields: [resource_id], references: [resource_id], onUpdate: NoAction)

  @@id([package_id, resource_id])
}

model packages {
  package_id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String          @db.VarChar(150)
  owner_department_id String?         @db.Uuid
  description         String?
  package_items       package_items[]
  departments         departments?    @relation(fields: [owner_department_id], references: [department_id], onDelete: Cascade, onUpdate: NoAction)
}

model permissions {
  permission_id    String             @id(map: "permissions_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String?            @db.VarChar(150)
  slug             String             @db.VarChar(255)
  description      String?            @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

model profiles {
  user_id       String   @id(map: "profiles_pk") @db.Uuid
  first_name    String?  @db.VarChar(100)
  last_name     String?  @db.VarChar(100)
  avatar_url    String?
  phone_number  String?  @db.VarChar(20)
  date_of_birth DateTime @db.Date
  bio           String?
  shift         String?  @db.VarChar(50)
  users         users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "profile_users_user_id_fk")
}

model requirement_items {
  item_id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requirement_id            String                      @db.Uuid
  catalog_id                String?                     @db.Uuid
  description               String
  quantity                  Decimal                     @default(1) @db.Decimal(10, 2)
  unit_measure              String                      @db.VarChar(50)
  unit_cost                 Decimal                     @default(0) @db.Decimal(12, 2)
  total_cost                Decimal?                    @default(dbgenerated("(quantity * unit_cost)")) @db.Decimal(12, 2)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  flight_requirements_meta  flight_requirements_meta[]
  lodging_requirements_meta lodging_requirements_meta[]
  item_catalogs             item_catalogs?              @relation(fields: [catalog_id], references: [catalog_id], onUpdate: NoAction)
  activity_requirements     activity_requirements       @relation(fields: [requirement_id], references: [requirement_id], onDelete: Cascade, onUpdate: NoAction)
}

model reservation_personnel {
  reservation_id String       @db.Uuid
  user_id        String       @db.Uuid
  reservations   reservations @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade, onUpdate: NoAction)
  users          users        @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@id([reservation_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservation_resources {
  reservation_id String       @db.Uuid
  resource_id    String       @db.Uuid
  quantity       Int
  reservations   reservations @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade, onUpdate: NoAction)
  resources      resources    @relation(fields: [resource_id], references: [resource_id], onUpdate: NoAction)

  @@id([reservation_id, resource_id])
}

model reservation_spaces {
  reservation_id String       @db.Uuid
  space_id       String       @db.Uuid
  reservations   reservations @relation(fields: [reservation_id], references: [reservation_id], onDelete: NoAction, onUpdate: NoAction, map: "reservation_spaces_reservation_id_fk")
  spaces         spaces       @relation(fields: [space_id], references: [space_id], onDelete: NoAction, onUpdate: NoAction, map: "reservation_spaces_space_id_fk")

  @@id([reservation_id, space_id], map: "reservation_spaces_pk")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  reservation_id        String                  @id(map: "reservation_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String?                 @db.VarChar(255)
  description           String?
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  activity_id           String?                 @db.Uuid
  status                reservation_status?     @default(active)
  creator_id            String                  @db.Uuid
  start_time            DateTime?               @db.Timestamptz(6)
  end_time              DateTime?               @db.Timestamptz(6)
  notifications         notifications[]
  reservation_personnel reservation_personnel[]
  reservation_resources reservation_resources[]
  reservation_spaces    reservation_spaces[]
  activities            activities?             @relation(fields: [activity_id], references: [activity_id], onDelete: Restrict, onUpdate: NoAction, map: "reservations_activity_id_fk")
  users                 users                   @relation(fields: [creator_id], references: [user_id], onUpdate: NoAction, map: "reservations_creator_id_fk")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resources {
  resource_id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @db.VarChar(150)
  type                  resource_type
  status                resource_status?        @default(active)
  total_quantity        Int
  owner_department_id   String?                 @db.Uuid
  description           String?
  package_items         package_items[]
  reservation_resources reservation_resources[]
  departments           departments?            @relation(fields: [owner_department_id], references: [department_id], onUpdate: NoAction)
  space_fixed_resources space_fixed_resources[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: NoAction, onUpdate: NoAction, map: "role_permissions_permission_id_fk")
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "role_permissions_role_id_fk")

  @@id([role_id, permission_id], map: "role_permissions_pk")
}

model roles {
  role_id          String             @id(map: "roles_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String?            @db.VarChar(100)
  description      String?            @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model space_fixed_resources {
  space_id    String    @db.Uuid
  resource_id String    @db.Uuid
  quantity    Int
  resources   resources @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade, onUpdate: NoAction)
  spaces      spaces    @relation(fields: [space_id], references: [space_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([space_id, resource_id])
}

model spaces {
  space_id              String                  @id(map: "spaces_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String?                 @db.VarChar(255)
  description           String?
  capacity              Int?
  status                space_status            @default(active)
  reservation_spaces    reservation_spaces[]
  space_fixed_resources space_fixed_resources[]
}

model user_roles {
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  roles      roles     @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_role_id_fk")
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_user_id_fk")

  @@id([user_id, role_id], map: "user_roles_pk")
}

model user_statuses {
  status_id   String    @id(map: "user_statuses_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users[]
}

model user_types {
  type_id     String    @id(map: "user_types_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?   @db.VarChar(50)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users[]
}

model users {
  username              String?                 @db.VarChar(50)
  user_id               String                  @id(map: "users_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                  @db.VarChar(150)
  password_hash         String                  @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  status_id             String                  @db.Uuid
  type_id               String?                 @db.Uuid
  department_id         String?                 @db.Uuid
  activities            activities[]
  activity_personnel    activity_personnel[]
  notifications         notifications[]
  profiles              profiles?
  reservation_personnel reservation_personnel[]
  reservations          reservations[]
  user_roles            user_roles[]
  departments           departments?            @relation(fields: [department_id], references: [department_id], onUpdate: NoAction)
  user_statuses         user_statuses           @relation(fields: [status_id], references: [status_id], onDelete: NoAction, onUpdate: NoAction, map: "users_status_id_fk")
  user_types            user_types?             @relation(fields: [type_id], references: [type_id], onDelete: NoAction, onUpdate: NoAction, map: "users_type_id_fk")
}

enum activity_status {
  pending
  approved
  rejected
  rescheduled
  cancelled
}

enum activity_type {
  ordinary
  extraordinary
  entry
}

enum reservation_status {
  active
  in_use
  cancelled
  completed
}

enum resource_status {
  active
  maintenance
  retired
}

enum resource_type {
  fixed
  dynamic
}

enum space_status {
  active
  inactive
  undermaintenance
}
